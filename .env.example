# ─────────────────────────────────────────────────────────────
# RobinCalls — environment template
# Copy to .env.local and fill in. NEVER commit .env.local.
# ─────────────────────────────────────────────────────────────

# ── Self-hosted Postgres (docker-compose: postgres + pgbouncer) ──
# Root credentials for the postgres container itself (docker-compose.yml
# `environment:`, NOT read by the Next.js app). Generate a real password —
# don't ship the placeholder.
POSTGRES_DB=robincalls
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
# Password for the app's own least-privilege role (robincalls_app), used to
# build docker-compose's DATABASE_URL and pgbouncer's userlist.txt SCRAM hash
# (see docker/pgbouncer/userlist.txt.example). Create that role by hand once:
#   CREATE ROLE robincalls_app LOGIN PASSWORD '...';
APP_DB_PASSWORD=
# Host path for Postgres's actual data directory — a bind mount, deliberately
# NOT a Docker-managed named volume, so `docker compose down -v` / `docker
# volume rm` / `docker system prune --volumes` can't take it out by accident.
# Point this at a separate disk/mount if you have one. Defaults to a
# repo-local ./data/postgres if unset (fine for a single-disk VPS, just make
# sure whatever backs up this host also backs up that path).
POSTGRES_DATA_DIR=./data/postgres

# ── Self-hosted Valkey (docker-compose: valkey) ──
# ioredis connection string. Unset → rate limiting and scan coordination
# no-op in dev, and DISABLE fresh scans in production (same fail-safe as the
# old Upstash setup). docker-compose sets this to redis://valkey:6379 for
# the app container automatically — only needed here for local dev against
# a Valkey you're running yourself.
REDIS_URL=

# ── Cloudflare Tunnel (docker-compose: cloudflared) ──
# Remotely managed tunnel. Put the connector token from Zero Trust → Networks
# → Tunnels in the real .env file; ingress/public-hostname rules live in the
# Cloudflare dashboard. No local cloudflared config.yml is read by Compose.
CLOUDFLARE_TUNNEL_TOKEN=

# ── Robinhood Chain (chain id 4663, Arbitrum Orbit L2) ──
# TWO RPC vars, and they are not interchangeable.
#
# ROBINHOOD_RPC_URL is SERVER-ONLY: the scanner, the jobs, the ledger anchor.
# It may be a keyed/paid endpoint — Next never inlines a non-NEXT_PUBLIC var
# into the client bundle, so it cannot leak (verified against a real build).
# Runtime env on the VM; no rebuild needed.
ROBINHOOD_CHAIN_ID=4663
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
#
# NEXT_PUBLIC_RPC_URL is the BROWSER's. It is what viem reads on the sale page
# AND the payload of wallet_addEthereumChain — i.e. it is written into the
# user's wallet and used by their own activity from then on.
#
# So it MUST be a public, unkeyed endpoint. A keyed URL here ships in the
# client bundle and bills your quota for every visitor forever, with no way to
# retract it. BUILD-time (baked by `next build`): set it as a GitHub Actions
# repo Variable and rebuild — an edit on the VM does nothing.
# Unset falls back to the public mainnet endpoint, which is a fine default.
#NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Optional fallback RPC (e.g., Alchemy requires an API key)
# Format: https://arb-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
ROBINHOOD_RPC_FALLBACK_URL=

# ── Explorer (Blockscout-compatible API) ──
# Confirm the exact host — see "what I need from you" in BUILD_NOTES.md
# Default here is the community instance directly (anonymous, ~3 req/sec,
# shared across every scan AND every cron job — this is what produced the
# RC_EXPLORER_UNAVAILABLE 429/500 storms and RC_RPC_NO_HEALTHY_PROVIDER
# cascades in production). Strongly prefer Blockscout's PRO multichain
# gateway instead: EXPLORER_API_URL=https://api.blockscout.com/<chainId>/api/v2
# with EXPLORER_API_KEY set — a per-account key created at dev.blockscout.com,
# raises the ceiling well above the anonymous limit. EXPLORER_WEB_URL is
# unrelated and always stays the community instance (user-facing "view on
# explorer" links — api.blockscout.com has no browsable UI).
EXPLORER_API_URL=https://robinhoodchain.blockscout.com/api/v2
#EXPLORER_API_KEY=
EXPLORER_WEB_URL=https://robinhoodchain.blockscout.com

# lib/explorer/router.ts weight-distributes addressInfo/tokenInfo/tokenHolders/
# transaction across Blockscout + Robinscan (undocumented, Robinhood/Blockscan-
# unaffiliated third party — see lib/explorer/robinscan.ts). Percent chance a
# call goes to Robinscan; default 30 if unset. addressInfo is exempt regardless
# of this value — it feeds the CRITICAL scam-tag check, which Robinscan has no
# data for (router.ts pins it to Blockscout).
#EXPLORER_ROBINSCAN_WEIGHT=50
#EXPLORER_ROBINSCAN_URL=https://robinscan.io/api

# ── DEX contract addresses on Robinhood Chain (Uniswap-V3 style) ──
# Needed for honeypot simulation + LP custody checks. Fill in real addresses.
QUOTER_V2_ADDRESS=0x33e885eD0Ec9bF04EcfB19341582aADCb4c8A9E7
SWAP_ROUTER_ADDRESS=0x0000000000000000000000000000000000000000
NONFUNGIBLE_POSITION_MANAGER_ADDRESS=0x0000000000000000000000000000000000000000
V3_FACTORY_ADDRESS=0x0000000000000000000000000000000000000000
# USDG — canonical settlement stable; the second quote asset discovery pairs
# against (many launchpad tokens keep their deepest pool USDG-quoted). Defaults
# to the canonical address in dex-registry.ts if unset; override here.
#USDG_ADDRESS=0x5fc5360d0400a0fd4f2af552add042d716f1d168
WETH_ADDRESS=0x0000000000000000000000000000000000000000

# Canonical infrastructure assets, comma-separated. Scans acknowledge these as
# trusted chain plumbing instead of flagging them: holder-concentration /
# wash-turnover SKIP (chain-wide activity routes through them) and the exit
# simulation is marked not-applicable. NOT auto-populated — WETH must be
# listed explicitly or it loses infra treatment entirely.
# Chain 4663 values (docs.robinhood.com/chain/contracts, seeded into registry
# by migration 0018): WETH + USDG, the canonical settlement stablecoin.

# Proxy admins that are the chain's bridge/system owner (§15.7 #2),
# comma-separated. upgradeable_proxy scores a proxy under one of these as
# infrastructure (PASS with note) instead of a rug vector; any other live
# admin stays FAIL. Value below is WETH's live EIP-1967 admin slot on chain
# 4663, read directly on-chain 2026-07-17 (the Orbit bridge admin) — reverify
# on the explorer if the bridge is ever upgraded.

# ── Market data (GeckoTerminal) ──
# Network slug for chain 4663 on GeckoTerminal — verify the exact slug
GECKOTERMINAL_NETWORK=robinhood

# ── Canonical registry ──
CANONICAL_REGISTRY_URL=https://docs.robinhood.com/chain/contracts

# ── The Ledger — anchoring ("Robin" wallet) ──
# SERVER ONLY. Small gas float. Signs the periodic anchor tx.
ROBIN_ANCHOR_PRIVATE_KEY=
ROBIN_ANCHOR_ADDRESS=

# ── Internal job auth ──
# Shared secret protecting cron/admin API routes (generate: openssl rand -hex 32)
INTERNAL_JOB_SECRET=

# ── Observability (scan-capacity PRD §20, Phase 0) ──
# Central error capture + per-pipeline scan summaries, shown in /admin/logs.
# All defaults are safe; nothing here is required to run the app.
APP_ERROR_LOGGING_ENABLED=true
# Days of raw error events / scan-run rows kept by POST /api/jobs/log-retention
APP_ERROR_RETENTION_DAYS=30
SCAN_RUN_RETENTION_DAYS=30
# Byte cap for sanitized structured details on one error event
APP_ERROR_DETAIL_MAX_BYTES=16384
# Observability threshold (§11.7): scans above this many logical RPC calls are
# flagged rpc_budget_exceeded in /admin/logs. Not a correctness limit.
SCAN_RPC_CALL_BUDGET=25

# ── First-party analytics (analytics PRD) ──
# Pepper for HMAC-SHA256 visitor hashing. Combined with the UTC date to produce
# daily-scoped pseudonymous visitor IDs. Generate: openssl rand -hex 32
# No raw IPs are persisted; only the truncated hash reaches Postgres.
ANALYTICS_SALT_SECRET=
# Master switch for the /api/jobs/analytics-ingest endpoint. Off by default;
# flip after confirming the nginx_logs volume is mounted and the migration ran.
ENABLE_ANALYTICS_INGEST=false
# Size (bytes) at which the nginx-logrotate sidecar renames analytics.log to
# .1 and signals nginx to reopen. Default ~32MB. See docker-compose.yml's
# nginx-logrotate service comment for the full rename+drain mechanics.
#ANALYTICS_LOG_ROTATE_THRESHOLD_BYTES=33554432

# ── Scan capacity controls (scan-capacity PRD §9.1 — all optional) ──
# Defaults are the PRD launch values; uncomment only what you want to change.
# Fresh-pipeline budgets (checked and consumed atomically in Valkey):
#SCAN_IP_BURST_LIMIT=3
#SCAN_IP_BURST_WINDOW_SECONDS=600
#SCAN_IP_DAILY_LIMIT=25
#SCAN_GLOBAL_BURST_LIMIT=5
#SCAN_GLOBAL_BURST_WINDOW_SECONDS=60
#SCAN_GLOBAL_MAX_CONCURRENT=1
#SCAN_GLOBAL_DAILY_PIPELINE_LIMIT=250
#SCAN_GLOBAL_DAILY_RECEIPT_LIMIT=100
# Background/cron admission budget (Group R M17) — a separate, own-key
# reservation so background jobs (curve-poll, tracker-poll, etc.) can never
# consume the interactive concurrency slot above. Primitive only: no
# background job calls admitBackgroundWork() yet.
#SCAN_BACKGROUND_MAX_CONCURRENT=1
# Cooldown + result caching:
#SCAN_TOKEN_COOLDOWN_SECONDS=600
#SCAN_RESULT_CACHE_SECONDS=900
#SCAN_FAILURE_CACHE_SECONDS=60
#SCAN_CANONICAL_MAX_AGE_SECONDS=21600
#SCAN_MATERIAL_LIQUIDITY_CHANGE_PCT=10
# Token lock (one pipeline per token):
#SCAN_LOCK_TTL_SECONDS=210
#SCAN_LOCK_WAIT_SECONDS=20

# ── Kill switches (PRD §20.6 — default ON, set "false" to shed load) ──
#ENABLE_PUBLIC_SCAN=true
#ENABLE_FRESH_SCAN=true
#ENABLE_LEDGER_APPEND=true

# ── RPC provider pool (PRD §11.1 — optional) ──
# Ordered JSON array; the first healthy provider serves, later entries are
# fallbacks. ids are non-secret and appear in evidence/logs; URLs never do.
# When unset, ROBINHOOD_RPC_URL/_FALLBACK_URL above are translated into the
# pool (that pair is deprecated).
# `preferMethods` (audit HIGH-2): the endpoint serves those methods FIRST —
# route eth_getLogs to the public RPC (unbounded ranges) while eth_call stays
# on the paid primary. Ordering only; failover across the pool is unchanged.
# `capabilities` (Stream 2): the capability router DROPS a provider before
# ranking when a request exceeds what it declared it can serve — e.g. a provider
# with capabilities.maxLogSpan:10 is never offered a wider eth_getLogs range
# (that's Alchemy's free-tier 10-block cap becoming a routing rule, not a
# runtime -32600). Fields: {maxLogSpan?, denyMethods?, allowMethods?}.
#
# Goldsky Edge RPC as a 4th provider (§B.5) — standard JSON-RPC, so it's a
# config-only plug-in. VERIFIED live on chain 4663: a 25k-block eth_getLogs
# returns {code:-32012,"getLogs request exceeded max allowed range"}, which the
# router already classifies as splittable, so maxLogSpan:19999 keeps every log
# read inside Edge's 20k window. Secret in .env.production ONLY, never committed.
#RPC_ENDPOINTS_JSON=[{"id":"alchemy-primary","url":"https://robinhood-mainnet.g.alchemy.com/v2/KEY","maxCuPerSecond":500,"maxConcurrentRequests":4,"capabilities":{"maxLogSpan":10}},{"id":"robinhood-public","url":"https://rpc.mainnet.chain.robinhood.com","maxConcurrentRequests":2,"preferMethods":["eth_getLogs"]},{"id":"goldsky-edge","url":"https://edge.goldsky.com/standard/evm/4663?secret=YOUR_GOLDSKY_EDGE_SECRET","maxCuPerSecond":100,"maxConcurrentRequests":2,"capabilities":{"maxLogSpan":19999}}]
#RPC_REQUEST_TIMEOUT_MS=12000
# Scan-wide RPC deadline: past it every remaining RPC call fails instantly (the
# honest-503 backstop — do not remove). Size it just under the scan route's
# maxDuration (180s); the 45s default starved late-pipeline reads on long scans.
#RPC_SCAN_DEADLINE_MS=55000
#RPC_CIRCUIT_FAILURE_THRESHOLD=5
#RPC_CIRCUIT_OPEN_SECONDS=60
#RPC_RECOVERY_PROBE_SECONDS=30
# Bounded retry when the WHOLE pool faults on transport errors (HIGH-2):
# total walks over the pool (2 = one retry) and the base backoff between walks.
#RPC_RETRY_WALKS=2
#RPC_RETRY_BACKOFF_MS=300
# MED-4: a proven trap on a pool below this liquidity keeps its live CRITICAL
# verdict but does NOT write the permanent Record mark. Unknown liquidity marks.
#HONEYPOT_MARK_MIN_LIQUIDITY_USD=100

# ── Production Runtime Safety Amendment (2026-07-20) ──
# Route-level terminal cutoff for a fresh scan: the pipeline is raced against
# this, and the client gets an explicit RC_SCAN_DEADLINE_EXCEEDED line instead
# of riding the platform to a forced stream close (the prod incident this
# amendment fixes). Keep it comfortably under the route's 180s maxDuration —
# the gap is reserved for scoring, receipt policy, persistence, cache
# publication, and stream close.
#SCAN_TERMINAL_DEADLINE_MS=180000

# ── Full-history log indexing (lib/rpc/log-index + lib/explorer/logs) ──
# Cold scans read event history from the EXPLORER'S indexed logs API (range
# size is irrelevant to an index; no RPC serves fromBlock:0 on this chain
# anymore). There is NO RPC fallback: an explorer outage hard-fails the scan
# (no verdict) instead of shipping an optimistic one. Rescans top up the Redis
# cache with one small RPC read. Nothing to tune here.

# ── Market data providers (PRD §11.8) ──
# dexscreener is primary as of 2026-07-22 — the shadow comparison validated
# (0 divergences) and it has ~10x GeckoTerminal's rate ceiling (300 req/min
# vs ~30). The wash check's trade-density signal is recovered via ONE
# GeckoTerminal call, but only for turnover-suspicious tokens (hybrid
# enrichment, Wave C part 2) — DexScreener has no buyers/sellers.
MARKET_SCAN_PROVIDER=dexscreener
# Run the non-primary provider alongside every fresh scan and log a
# comparison line — leave off unless re-validating a provider switch (in
# shadow mode the wash enrichment reuses the shadow GT call — no extra request):
ENABLE_MARKET_SHADOW_COMPARE=false
#DEXSCREENER_BASE_URL=https://api.dexscreener.com
#DEXSCREENER_CHAIN_ID=robinhood
#MARKET_REQUEST_TIMEOUT_MS=8000
# Slow-rug/pump-dump monitor batching (30 = DexScreener's hard batch cap):
#MARKET_MONITOR_BATCH_SIZE=30

# ── Tracker discovery (PRD §11.8, Wave C part 2) ──
# Primary discovery is on-chain V2/V3 factory events (needs V2_FACTORY_ADDRESS
# and/or V3_FACTORY_ADDRESS below). GeckoTerminal /new_pools is a fallback only,
# useful during the migration window to catch pools that cross a threshold after
# creation (a token un-indexed by DexScreener at discovery time is missed until
# then). Cursor + range tuning (defaults shown):
#ENABLE_GECKOTERMINAL_TRACKER_FALLBACK=false
#TRACKER_CONFIRMATIONS=5            # blocks behind head before an event is final
#TRACKER_MAX_BLOCKS_PER_POLL=50000  # bound per factory per poll (resumable)
#TRACKER_BACKFILL_BLOCKS=50000      # first-run seed window behind head

# Bonding-curve progress needed before a launchpad candidate surfaces on the
# public Watchlist (lib/config/curves.ts). PROVISIONAL, NOT FINAL (2026-07-23)
# — reinstated the original PRD's 5000bps (50%) after a later pass lowered it
# to 100bps and surfaced tokens at ~0.1% filled. See memory
# watchlist-bonding-threshold-todo before changing this again.
#CURVE_BONDING_SURFACE_BPS=5000

# ── The Watch — slow-rug / pump-dump monitor (PRD §4.3, §15.4–§15.5) ──
# Gates POST /api/jobs/slow-rug (403 without it) — the hourly job that writes
# liquidity snapshots, flags gradual drains, and stamps pump_dump marks. Its
# drain rows are also criterion C for the Wanted Board. The 0010 cron schedules
# the route regardless; this flag decides whether the route does work or no-ops.
#ENABLE_SLOW_RUG_MONITOR=false
# Phase 3 #4 — funding-lineage tracing job (writes wallet_stains). Gates
# POST /api/jobs/lineage-trace.
#ENABLE_LINEAGE_TRACE=false

# ── Detection pack (PRD §15.4–§15.5) ──
# Pump-and-dump postmortem: collapse from the trailing fast-window peak that
# writes a permanent pump_dump mark (job also requires ENABLE_SLOW_RUG_MONITOR).
#PUMP_DUMP_COLLAPSE_PCT=0.95
#PUMP_DUMP_WINDOW_HOURS=72

# ── Uniswap V2 (pair discovery + LP custody live; deep sell-sim is Wave D remainder) ──
# Factory VERIFIED on-chain 2026-07-14 from two live pairs (getPair round-trip).
# Read by the Tracker's factory-event discovery (PairCreated) AND the lib/dex/v2
# adapter (pool discovery + LP custody) when ENABLE_UNISWAP_V2=true.
# Router02 VERIFIED 2026-07-14: factory()/WETH() round-trip OK — the deep
# sell-sim will use the classic supporting-fee swap path (PRD §14.6).
#V2_FACTORY_ADDRESS=0x8bCEAa40B9ACdFaEDf85ADF4Ff01F5aD6517937f
#V2_UNIVERSAL_ROUTER_ADDRESS=0x8876789976DECbFCbbbE364623C63652db8C0904
#V2_ROUTER02_ADDRESS=0x89e5DB8B5aA49aA85AC63f691524311AEB649eba
# Trusted LP lockers are managed in the DB (trusted_lockers table, /admin/lockers).
#ENABLE_UNISWAP_V2=false

# ── Uniswap V4 (pool discovery + sell-sim live when enabled) ──
# V4 is a singleton: no per-pool contract. Pools live inside PoolManager keyed by
# a PoolKey (currency0, currency1, fee, tickSpacing, hooks); reads/quotes go via
# StateView + the V4 Quoter. On chain 4663 the common launch pattern is V4 + a
# swap HOOK + dynamic fee, and the hook is the honeypot vector — the sim quotes
# both directions through the V4 Quoter (which runs the hook). Discovery finds a
# token's pools (hooked included) via indexed PoolManager Initialize logs.
#V4_POOL_MANAGER_ADDRESS=
#V4_STATE_VIEW_ADDRESS=
#V4_QUOTER_ADDRESS=
# V4 PositionManager ("Uniswap v4 Positions NFT" / UNI-V4-POSM). Optional, but
# WITHOUT it §15.10's LP-whale check is dead on V4: the PoolManager's liquidity
# events name the PositionManager as `sender`, never the human, so every NFT
# position is untraceable and V4 custody honestly SKIPs. Set, the position's salt
# (= bytes32(tokenId)) resolves to the real owner via ownerOf. Verify a candidate
# by round-tripping poolManager() against V4_POOL_MANAGER_ADDRESS.
#V4_POSITION_MANAGER_ADDRESS=

# Multicall3 — OPTIONAL but strongly recommended: it is the single biggest RPC
# cost reduction available (ERC-20 metadata 15 calls -> 1, V4 liquidity ranking
# 32 -> 1, V4 position ownership 166 -> 3). Unset means every read is issued
# individually, which still works but burns provider throughput.
#
# NOT defaulted on purpose, and still bytecode-probed at runtime rather than
# assumed — a configured address with no code would turn every batched read
# into a revert. The canonical deployment WAS verified present on chain 4663
# (2026-07-21): eth_getCode at 0xcA11bde05977b3631167028862bE2a173976CA11
# returns the standard Multicall3 runtime, and a live batch was cross-checked
# value-for-value against individual reads at a pinned block.
#
# Measured on chain 4663 with this address set — cross-DEX pool discovery for
# one token: 29 physical eth_calls -> 2, identical pool set both ways.
MULTICALL3_ADDRESS=0xcA11bde05977b3631167028862bE2a173976CA11
# Not yet read by the app — staged for Permit2-based V4 swap execution.
#PERMIT2_ADDRESS=0x000000000022D473030F116dDEE9F6B43aC78BA3
#ENABLE_UNISWAP_V4=false

# ══════════════════════════════════════════════════════════════════════════
# ADDITIONAL DEXes — the blocks above are the PRIMARY deployment (Uniswap).
# Robinhood Chain hosts several Uniswap-fork DEXes and a token's DEEPEST pool can
# live on any of them (SUSHICAT kept 74% of its liquidity on SushiSwap V3, which
# a Uniswap-only scan never saw). Every DEX below is a standard fork — adding one
# is addresses-only, no new code. Coverage is tiered: a FACTORY alone powers pool
# discovery + materiality; the peripherals add that DEX's own custody + sim.
# These are PUBLIC contract addresses (not secrets); set the same values in prod.
#
# All VERIFIED on-chain 2026-07-18 by deployer-sibling derivation + a factory()
# back-reference on every router/quoter/NPM. Consumed once multi-DEX discovery
# wiring lands.
# ══════════════════════════════════════════════════════════════════════════

# ── SushiSwap (V2 + V3 + V4) — deployer 0x6219D85BB128091c2269dd478BfD331a2aa63318 ──
#SUSHI_V2_FACTORY_ADDRESS=0xe52abd50ad151ecdf56427effd715e703696a6b1
#SUSHI_V2_ROUTER02_ADDRESS=0x9a55d3d0c0f09859c7869510f53ed0a30b340766
#SUSHI_V3_FACTORY_ADDRESS=0xe51960f1b45f1c9fb6d166e6a884f866fc70433b
#SUSHI_V3_SWAP_ROUTER_ADDRESS=0x1e406484f1f204b23ce84b9901c0171a738fd406
#SUSHI_V3_QUOTER_V2_ADDRESS=0x3e290e5e01818002a0b672148bdc7514d861c7b3
#SUSHI_V3_POSITION_MANAGER_ADDRESS=0x51d0e5188afe12d502e29d982d20c190e7816107
# SushiSwap ships NO V4 on this chain — only V2 + V3.
#ENABLE_SUSHISWAP=false

# ── PancakeSwap (V2 + V3; no V4 on this chain) ──
#PANCAKE_V2_FACTORY_ADDRESS=0x02a84c1b3bbd7401a5f7fa98a384ebc70bb5749e
#PANCAKE_V2_ROUTER02_ADDRESS=0x8cfe327cec66d1c090dd72bd0ff11d690c33a2eb
#PANCAKE_V3_FACTORY_ADDRESS=0x0bfbcf9fa4f9c56b0f40a671ad40e0805a091865
#PANCAKE_V3_SWAP_ROUTER_ADDRESS=0x1b81d678ffb9c0263b24a97847620c99d213eb14
#PANCAKE_V3_QUOTER_V2_ADDRESS=0x8553aa1615549a86882151784b329b017aa7c832
#PANCAKE_V3_POSITION_MANAGER_ADDRESS=0x46a15b0b27311cedf172ab29e4f4766fbe7f4364
# No PancakeSwap V4 on this chain. Full V2 + V3 set — all verified on-chain.
#ENABLE_PANCAKESWAP=false

# LP-custody event indexing (§15.10 — the non-deployer LP whale on V3/V4). V3
# reads the pool's Mint logs and follows each to the position NFT's current
# owner; V4 replays the singleton's ModifyLiquidity logs for one poolId. Event
# history comes from the explorer index (see "Full-history log indexing").
# MINT_TX_BUDGET bounds the V3 receipt fetches used to turn a pool Mint into a
# tokenId; a pool with more adds than this is under-attributed, which surfaces
# as a SKIP rather than a wrong answer.
#LP_CUSTODY_MINT_TX_BUDGET=12
# A token can sit in dozens of V4 fee-tier/hook pools (most dead). Each custody
# read is a full-history getLogs, so reading all of them can exhaust the scan
# deadline and cascade later checks into degraded answers. The custody audit
# ranks V4 pools by active liquidity (one cheap StateView read each) and only
# indexes the top N; the rest are recorded UNKNOWN (they never indict).
#LP_CUSTODY_V4_POOL_CAP=6
# Contracts that hold LP under a lock score the pool LOCKED instead of being
# read as a whale. The allowlist lives in the DB now (trusted_lockers table,
# managed at /admin/lockers) — no env var, no redeploy to bless a new locker.
# Max adapter (V2/V4) sell-sims per scan — bounds a token sitting in many V4 fee
# tiers. Ordered canonical-counter-first and short-circuits on the first PASS.
#ADAPTER_SELL_SIM_CAP=10
# Token-scoped liquidity-pull indexing (§15.9): finds removals on the token's own
# V2 pair attributed to the deployer via Transfer(from=deployer,to=pair), read
# from the explorer index. No tuning knobs.

# ── Contract & authority audit (docs/ways-of-work/plan/contract-audit/) ──
# M8 wiring is DONE (2026-07-22) — pipeline.ts calls the audit when this is on.
# Evidence goes into verdict.contractAudit, never verdict.checks[], so it can
# never touch score/tier/ledger fingerprints. Leave off in production until
# rollout steps 5-8 (golden-corpus review, monitoring, kill switch) finish —
# see implementation-plan.md's milestone ledger. Safe to leave on for local dev.
#ENABLE_CONTRACT_AUTHORITY_AUDIT=false
#CONTRACT_AUTHORITY_AUDIT_ROLLOUT_PCT=100
# Extra RPC/explorer calls and CPU the audit may spend on top of the existing
# scan budget, and the recursion/facet/source-size caps that keep proxy and
# diamond resolution bounded. Exceeding any of these produces an incomplete
# finding, never a cleaner PASS.
#AUDIT_MAX_EXTRA_RPC_CALLS=15
#AUDIT_MAX_EXPLORER_CALLS=10
#AUDIT_MAX_PROXY_DEPTH=4
#AUDIT_MAX_DIAMOND_FACETS=8
#AUDIT_MAX_SOURCE_BYTES=1048576
#AUDIT_STATIC_CPU_TARGET_MS=500
# Wall-clock cutoff (ms from scan start, not audit start) past which the audit
# stops starting new work so the route keeps time for scoring/receipt/cleanup.
#AUDIT_WALL_CLOCK_CUTOFF_MS=51000

# ── Rate limiting + scan coordination ──
# Per-IP sliding-window limits on /api/scan, /api/directory/submit,
# /api/stats, /api/og/* (proxy.ts) AND the scan-capacity coordination layer
# (locks, cooldown cache, fresh-pipeline budgets). If unset: development
# falls back to in-process limits; PRODUCTION DISABLES FRESH SCANS (PRD
# §10.4) — cached and ledger reads keep working.
# Configured via REDIS_URL near the top of this file (self-hosted Valkey,
# docker-compose sets it automatically for the app container) — nothing to
# set here.

# ── AI plane: MCP + the chat surface (services/agent, FastAPI) ──
# MCP moved OFF Next.js on 2026-08-02. It is now POST /mcp on the `agent`
# container; app/api/mcp/route.ts and lib/mcp/tools.ts are deleted. See MCP.md
# and docs/ways-of-work/plan/ai-plane/implementation-plan.md.
#
# Read by the `agent` container, where OFF means POST /mcp returns 404 —
# checked before the bearer gate, so a disabled surface does not advertise that
# it exists and is merely shut. Next.js reads the same variable only to render
# the capacity dashboard tile; the two must agree, and for one release they did
# not (nothing read it, the tile said "off", the endpoint served the internet).
#
# Leave it OFF until K1 is closed: /mcp has one shared bearer token and no
# per-caller identity, quota or revocation.
ENABLE_MCP=false

# REQUIRED in production: the agent REFUSES TO BOOT without it, because /mcp
# would otherwise be an open, unmetered surface onto the scan pipeline.
# Generate one with:  openssl rand -hex 32
#
# Left COMMENTED on purpose. As a bare `MCP_AUTH_TOKEN=` this line was copied
# into .env.production verbatim, and an empty value is not the same as a
# missing one: the agent booted, refused itself, exited, and `restart:
# unless-stopped` looped it forever while the deploy stayed green. Commented,
# compose's `${MCP_AUTH_TOKEN:?}` now fails the deploy instead — loudly, once,
# before anything starts.
#MCP_AUTH_TOKEN=

# The agent's only egress to Next is /api/internal/v1/*, behind requireJobAuth
# (and denied at nginx). Reuses INTERNAL_JOB_SECRET from the jobs section — the
# agent refuses to boot if it is unset, since every tool read would 401.
#AGENT_ENV=production
#NEXT_INTERNAL_BASE_URL=http://app:3000

# Our-models chat. Unset = the our-models path is off (BYOK still works, since
# that runs entirely in the browser against the user's own key). MCP does not
# need a model at all.
#
# NOTE: production REFUSES to boot with either key set until the credit system
# lands (METERING_IMPLEMENTED in settings.py). Without metering /agent/chat has
# no caller identity and no quota, so the key would be spendable by anyone who
# can reach the site. Use AGENT_ENV=development to exercise it locally.
#ANTHROPIC_API_KEY=
#GEMINI_API_KEY=
# anthropic | gemini. Unset = inferred from whichever key is set (Anthropic
# wins if both are, so a billed path never switches on variable ordering).
#AGENT_PROVIDER=
# Unset = the selected provider's default (claude-sonnet-5 / gemini-3.5-flash-lite).
# Never share one value across providers — a Claude id sent to Gemini is a 404.
#AGENT_MODEL=
#AGENT_MAX_OUTPUT_TOKENS=2048
# One model response. Must stay under AGENT_NEXT_SCAN_TIMEOUT_S so the chain
# nginx 210 > agent 200 > model 180 stays ordered. Measured: flash-lite on the
# free tier took 173s for a 4.2k-token request with 15 tools.
#AGENT_MODEL_TIMEOUT_S=180
# Per-turn ceiling on tool calls. Each iteration spends credits and RPC budget,
# so this is enforced, not advisory.
#AGENT_MAX_TOOL_CALLS=8
# The prompt version is a CODE constant (`prompt_version` in
# services/agent/app/settings.py), deliberately not an env var — see below.

# Timeouts. The scan one MUST clear the pipeline's ~180s terminal deadline, or
# an honest slow scan comes back as a transport fault and gets narrated by the
# agent as a finding about the token.
#AGENT_NEXT_READ_TIMEOUT_S=15
#AGENT_NEXT_SCAN_TIMEOUT_S=200

# Ceiling on the transcript sent to the model, in approximate tokens. The
# browser holds the full conversation; this bounds what each turn re-sends,
# because an unbounded transcript is a bill that grows quadratically and then
# hard-fails on context length mid-conversation.
#AGENT_MAX_HISTORY_TOKENS=24000

# Which prompt produced an answer — stamped on every stored conversation, every
# cached prompt and every diagnostics line, so a report can be traced to the
# text that caused it.
#
# REMOVED 2026-08-17. `docker-compose.yml` no longer passes PROMPT_VERSION
# through, so setting it here does nothing. The code default in
# services/agent/app/settings.py is the only version. It was pinned at 7 on
# 2026-08-05 and at 11 until today, and both times the prompt shipped wearing a
# stale number — which is why the env route is gone rather than documented.

# Per-turn diagnostics are one structured log line: token/cache counts, tool
# names and outcomes, stripped-claim counts, provenance rejections, latency.
# Never message text, tool arguments, wallets or IPs. The trace id is included
# by default because it is how you debug a specific report — it is joinable to
# a scan in Next's logs, so set this to 0 if you want the records to carry no
# correlation handle at all.
#AGENT_TELEMETRY_TRACE_IDS=1

# ── Client-side RPC (the browser executes these, so they cost us nothing) ──
# NOT RPC_ENDPOINTS_JSON. That variable holds real secrets (an Alchemy key in a
# path, a Goldsky ?secret=) and must NEVER reach a browser. This list is served
# to the client and is validated at load: a query string, userinfo, or a
# key-looking path segment is refused outright.
#PUBLIC_CLIENT_RPC_URLS=https://rpc.mainnet.chain.robinhood.com
# How far behind the head a client-reported block may be before its result is
# refused. A lagging endpoint returns confidently stale data with no error.
#CLIENT_RPC_MAX_BLOCK_LAG=200
# Where a CLIENT-SIDE contract audit fetches verified source (the Auditor
# persona's run_contract_audit tool, which runs the whole audit in the
# visitor's browser). Must be the FREE community instance.
#
# NOT EXPLORER_API_URL. That one is the scanner's, points at Blockscout's PRO
# multichain gateway, and is paired with EXPLORER_API_KEY — pointing this at it
# would put our paid gateway in front of every visitor, unauthenticated and
# throttled, for no benefit. And `assert_keyless` cannot catch that mistake:
# the PRO key travels in a HEADER, so its URL passes every credential-shape
# check. What actually prevents it is docker-compose.yml's env allowlist for
# the `agent` service, which withholds EXPLORER_API_URL/EXPLORER_API_KEY
# entirely.
#
# Robinscan is deliberately not an option here: robinscanAdapter serves
# addressInfo/tokenInfo/tokenHolders/transaction only, and its
# smartContractFull returns null — it has no verified source to give.
#PUBLIC_EXPLORER_API_URL=https://robinhoodchain.blockscout.com/api/v2
# Ceiling for client- and local-locale tool calls in one turn. These run in the
# browser or in the agent process, so they cost us nothing — metered separately
# from AGENT_MAX_TOOL_CALLS, which is the budget for OUR RPC and database.
#AGENT_MAX_FREE_TOOL_CALLS=40

# ── Agent operations ──
# The agent verifies at boot that every check the engine can publish has an
# explainer on file, by calling get_methodology on `app`. Set this to 1 ONLY to
# break a cold-start deadlock — the agent needs `app` up, and if you are
# bringing the whole stack up at once it can lose that race. It logs loudly
# while waived, and while waived the agent can answer "I have no information on
# that check" for a live check. Unset it once the stack is up.
#AGENT_SKIP_COVERAGE_GATE=1
# DEBUG | INFO | WARNING | ERROR. Structured JSON lines either way.
#LOG_LEVEL=INFO

# ── Wanted Board ingestion (gated on PRD §7.6 rug criteria finalization) ──
# Off by default — the board renders, but nothing is ingested until you flip this.
# This flag is the LAST gate on the board filling: the producer
# (lib/wanted/producer.ts) assembles candidates from active drains and honeypot
# marks, and evaluateRug judges them. Flip it only when you're ready to stand
# behind the §7.6 criteria in public — indicting a wallet is the most
# consequential thing this system does, and RUG_CRITERIA_VERSION is stamped on
# every row it writes.
# Depends on ENABLE_SLOW_RUG_MONITOR for drain evidence (criterion C); honeypot
# evidence (criterion B) works without it, off verdict receipts.
ENABLE_WANTED_INGESTION=false
# RUG_CRITERIA_VERSION is NO LONGER READ FROM THE ENVIRONMENT (2026-08-19).
# It lives in lib/config/flags.ts as a plain constant. This variable used to
# override the code default and was pinned here at 0.2-draft, which silently
# killed two bumps: the string is what makes processRugCandidate re-evaluate a
# published indictment, so freezing it froze a correction in place on a live
# accusation (KNOWN-PROBLEMS L16). Setting it now does nothing. Delete the line
# from any .env you still have it in.

# ── Admin console (Better Auth) ──
# Direct Postgres connection string. Points at pgbouncer's port (6432), not
# postgres directly. Must use APP_DB_PASSWORD, never POSTGRES_PASSWORD —
# pgbouncer's userlist.txt only has a SCRAM entry for robincalls_app hashed
# from APP_DB_PASSWORD, so the superuser's password fails auth here.
# docker-compose sets this for the app container automatically; only needed
# here for host-side tools (create-admin.ts, drizzle-kit) or local dev.
DATABASE_URL=postgresql://robincalls_app:YOUR_DB_PASSWORD@localhost:6432/robincalls
# Session-signing secret. Generate: openssl rand -hex 32
BETTER_AUTH_SECRET=
# Public base URL of the app (used for auth callbacks/cookies).
BETTER_AUTH_URL=http://localhost:3000

# ── Admin seed (used ONLY by scripts/create-admin.ts, one-time) ──
# After filling these + DATABASE_URL + BETTER_AUTH_SECRET, create the admin with:
#   npx tsx scripts/create-admin.ts
# Re-running it RESETS the admin's password to ADMIN_PASSWORD (that's how you
# rotate it, or recover a lost password). It never creates a second admin.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Site ──
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── CDN for heavy static media (optional) ──
# Offloads the roadmap GLB + background/scene art to a Cloudflare R2 bucket
# behind a cdn.* domain (free egress) so Vercel bandwidth isn't spent on them.
# UNSET → assets serve from the local /public path (dev + any not-yet-configured
# env keep working). When set, the R2 bucket MUST mirror the same paths, e.g.
# public/models/roadmap-city.glb → <bucket>/models/roadmap-city.glb.
# Full setup steps + the cdn CNAME: docs/cdn-r2-setup.md.
#NEXT_PUBLIC_CDN_URL=https://cdn.robincalls.com

# ── Whitelist onboarding — RETIRED 2026-09-04 ──
# No env var enables it any more. lib/config/flags.ts hardcodes
# `whitelist: false as const`, so setting NEXT_PUBLIC_ENABLE_WHITELIST here (or
# as a GitHub Actions Variable) does nothing at all. Deleting the vars rather
# than setting them false, so nobody flips one and wonders why it is inert.

# ── Swap trading deploy ceiling (docs/cross-dex-router/MULTIHOP-ROUTER-PRD.md) ──
# Off by default. Admin settings control execution, venues, V4, and multihop.
ENABLE_SWAP_TRADING=false

# ── Wallet connect (docs/wallet-integration/WAYS-OF-WORK.md) ──
# Reown AppKit's project id — free at https://cloud.reown.com (Starter tier).
# Unset: injected/EIP-6963 wallets (MetaMask, Rabby, ...) still connect; only
# the WalletConnect QR/mobile path needs a real id. lib/wallet/appkit-config.ts.
NEXT_PUBLIC_REOWN_PROJECT_ID=
# The wallet-connect surface (sidebar connect/disconnect). This is now the ONLY
# switch behind that button — whitelist onboarding is retired, so the wallet no
# longer shares a lane with it. MUST be NEXT_PUBLIC (AppSidebar is a
# client component), so this is BUILD-time: in prod set it as a GitHub Actions
# repo VARIABLE and rebuild; an env edit on the VM does nothing.
NEXT_PUBLIC_ENABLE_WALLET=false
# Deprecated alias, still honoured so existing environments keep working.
#NEXT_PUBLIC_ENABLE_WALLET_TESTING=false

# ── Public token-sale page (/token-sale) ──
# Off = the route 404s. The admin cockpit at /admin/token-sale is NOT gated by
# this (requireAdmin only), so the sale can be driven and tested while the
# public page stays dark. Bare var, NOT NEXT_PUBLIC: the gate runs server-side,
# which makes this a RUNTIME switch — edit .env.production and restart, no
# rebuild. The sale address itself lives ONLY in site_config (set it from
# /admin/token-sale or admin → Settings); see lib/sale/address.ts.
#
# This ALSO gates the referral plane (docs/prds/REFERRALS.md): codes, the
# contribution mirror, /leaderboard and the airdrop snapshot. One switch, not
# two — referrals have no meaning without a sale. Off means the indexer job
# no-ops, /leaderboard 404s, and no referral surface renders.
#
# The referral thresholds are NOT here. They live in site_config (admin →
# Settings) so they can move without a restart, and every snapshot stores the
# values it was computed under.
ENABLE_TOKEN_SALE=false

# ── Token sale address: NOT an env var ──
# It lives only in the site_config table (key `token_sale_address`), set from
# /admin/token-sale or admin → Settings. There was a TOKEN_SALE_ADDRESS
# fallback here; it was removed 2026-09-08 because it could not express "no
# sale configured" (a set env answered anyway) and changing it needed a
# redeploy, which is what a runtime config row exists to avoid.
# Robinhood Testnet (chain id 46630) is a BUILD-TIME gate, not a runtime
# choice: a production bundle with this false never contains the testnet
# network, so no visitor can aim a real wallet at test ETH. lib/config/chain.ts.
#
# It reaches TWO lanes and no others:
#   `npm run dev` / `npm run build`   — from .env.local
#   the local smoke stack             — from `--env-file`, via compose args
#
# It CANNOT reach the image CI pushes. The workflow passes no such build-arg,
# so production is mainnet by construction rather than because a repo Variable
# happens to be unset — do not add one, there is nothing to receive it, and
# tests/testnet-build-lane.test.ts fails if the wire comes back.
NEXT_PUBLIC_ALLOW_TESTNET_CHAIN=false
# Optional overrides (defaults point at the public testnet endpoints):
#NEXT_PUBLIC_ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
#NEXT_PUBLIC_ROBINHOOD_TESTNET_EXPLORER_URL=https://explorer.testnet.chain.robinhood.com

# ── X / Twitter OAuth 2.0 (whitelist "Connect X", lib/x) ──
# Authorization Code + PKCE. In the X developer portal → your app →
# "User authentication settings": App permissions "Read and write"; Type of
# App "Web App, Automated App or Bot" (Confidential client); Callback URI —
# register BOTH http://localhost:3000/api/whitelist/x/callback (dev) and
# https://YOUR_DOMAIN/api/whitelist/x/callback (prod).
# Client ID is public; Client Secret is SERVER ONLY. Without TWITTER_CLIENT_ID
# set, the routes 503 instead of throwing — the app still builds without it.
# Only metered API call is GET /2/users/me on connect (free tier); follow/
# like/post are x.com/intent/* links in the browser — zero API.
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
# Space/comma-separated; defaults to "users.read tweet.read" (identity only).
#X_OAUTH_SCOPES=
# Override the callback URL only if a proxy/CDN rewrites the request origin.
#X_OAUTH_REDIRECT_URI=
# The tweet users post at the "share" step; else a sensible default.
#X_ONBOARDING_POST_TEXT=
# Key used to encrypt the OAuth session cookie; falls back to BETTER_AUTH_SECRET.
X_SESSION_SECRET=
# OAuth 1.0a credentials — legacy scheme, NOT used by the OAuth2 flow above.
# Currently unread by the app; kept only if some other tool needs them.
X_CONSUMER_KEY=
X_SECRET_KEY=
X_BEARER_TOKEN=

# ── Telegram (whitelist eligibility — alternative to X) ──
# FREE: the Login Widget payload is HMAC-verified locally and the single
# getChatMember Bot API call is free. Routes 503 until TELEGRAM_BOT_TOKEN is
# set. Setup: @BotFather → /newbot → token; add that bot as an ADMIN of your
# group (required for getChatMember); BotFather → /setdomain → your login
# domain. The Login Widget needs a PUBLIC domain — test on prod/preview, not
# localhost. Callback: /api/whitelist/telegram/verify.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_GROUP_CHAT_ID=
TELEGRAM_GROUP_URL=
# Optional dedicated cookie-encryption secret; falls back to BETTER_AUTH_SECRET.
#TG_SESSION_SECRET=

# ─────────────────────────────────────────────────────────────
# PRODUCTION NOTE — you do NOT need a separate .env.prod file.
# On Vercel, set these same keys in Project → Settings → Environment
# Variables (scope: Production). For the deployed site, the URL-bearing
# vars must point at the real domain, not localhost:
#   NEXT_PUBLIC_SITE_URL = https://robincalls.com
#   BETTER_AUTH_URL      = https://robincalls.com
# Everything else (DEX addresses, Valkey, MCP flags, admin secrets) is the
# same set of keys — just the Production values.
# .env.local stays for local dev only and is never committed.
# ─────────────────────────────────────────────────────────────

# ── Prod host id (scripts/ssm-psql.sh, the tracing skills) ──
# The EC2 instance the production stack runs on. Deliberately empty here: this
# repo is public, and an instance id in the source is free reconnaissance for
# anyone reading it. Set it in .env.local (gitignored) or export it; the script
# fails closed with instructions rather than guessing a host.
RC_INSTANCE_ID=

# ── GitHub Container Registry (for VM pulls) ──
# IMAGE_TAG can be pinned to a specific commit sha (e.g., "IMAGE_TAG=<sha>") for manual rollbacks.
IMAGE_TAG=latest
# GHCR_PAT MUST be a fine-grained GitHub PAT scoped to "read:packages" for this repo.
# NEVER commit a real token here. This is for the VM's .env.production only.
GHCR_PAT=
GHCR_USERNAME=

# ── Schema migrations on deploy (scripts/apply-migrations.sh) ──
# The deploy applies every pending supabase/migrations/*.sql before it starts
# the new image, recording each in a `schema_migrations` ledger. Neither key
# below is normally set; both exist so an ops decision does not need a code
# change.
#
# MIGRATION_HOLD — space-separated filenames to skip. DEFAULTS to holding
#   0052_launch_retention_hourly.sql, and that default is a safety property, not
#   a placeholder: 0052 turns launch retention hourly, which drains the expired
#   launch_candidates backlog in ~26h, and that backlog is the only surviving
#   record of the pool addresses the curve rug-recovery joins against. Release
#   it by setting the key to an EMPTY value — and only after
#   POST /api/jobs/curve-rug-recheck has run and the stranded rows are verified.
#   Setting it empty really does release it; the script reads ${MIGRATION_HOLD-…}
#   rather than ${MIGRATION_HOLD:-…} for exactly that reason.
#MIGRATION_HOLD=
#
# MIGRATION_BASELINE — consulted ONLY on the very first run, when the ledger
#   table does not yet exist: everything up to and including this file is
#   recorded as applied WITHOUT being executed. Existing databases carry
#   0001-0047 already, applied by hand. Changing it afterwards does nothing.
#MIGRATION_BASELINE=0047_explorer_address_info_cache.sql

# Uniswap Trading API key (developers.uniswap.org). Route comparison only.
UNISWAP_API_KEY=

# Prod -> local smoke sync (lib/sync/pull.ts, /api/sync/v1). Ed25519, generated once.
# PROD serves: set SYNC_PUBLIC_KEY (base64 SPKI) in .env.production. Unset = the route is a 404.
#SYNC_PUBLIC_KEY=
# LOCAL smoke pulls: private key (base64 PKCS8) in .env.local ONLY. Never on prod: a process
# holding SYNC_PUBLIC_KEY refuses to pull. The smoke compose sets PROD_SYNC_PULL=true.
#PROD_SYNC_URL=https://robincalls.com
#PROD_SYNC_SIGNING_KEY=
